{
  "name": "vscode-extensions",
  "private": false,
  "version": "0.0.0",
  "description": "Monorepo for VS Code extensions and shared packages",
  "license": "MIT",
  "workspaces": [
    "extensions/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "watch": "npm run watch --workspaces --if-present",
    "clean": "npm run clean --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "package": "npm run package --workspaces --if-present",
    "clean:vsix": "bash scripts/clean-vsix.sh",
    "uninstall:extension": "bash scripts/uninstall-extension.sh",
    "install:extension": "bash scripts/install-extension.sh",
    "reinstall": "bash scripts/reinstall.sh",
    "typecheck": "tsc --build",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2"
  }
}